# Confluence RAG - Environment Configuration
# Copy this file to .env and fill in your values
 
# =============================================================================
# CONFLUENCE SETTINGS (Required)
# =============================================================================
 
# Your Confluence Cloud URL (e.g., https://yourcompany.atlassian.net)
CONFLUENCE_URL=
 
# Your Atlassian account email
CONFLUENCE_EMAIL=
 
# Confluence API Token (generate at https://id.atlassian.com/manage-profile/security/api-tokens)
CONFLUENCE_API_TOKEN=
 
# Optional: Filter pages by space key (leave empty for all spaces)
CONFLUENCE_SPACE_KEY=
 
# =============================================================================
# OLLAMA SETTINGS (Optional - defaults shown)
# =============================================================================
 
# Ollama server URL
OLLAMA_BASE_URL=http://localhost:11434
 
# LLM model for generating answers
OLLAMA_LLM_MODEL=llama3.1:8b
 
# Embedding model for vector search
OLLAMA_EMBED_MODEL=nomic-embed-text
 
# =============================================================================
# RAG SETTINGS (Optional - defaults shown)
# =============================================================================
 
# ChromaDB storage location
CHROMA_PERSIST_DIR=./confluence_db
 
# Text chunking settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
 
# Number of chunks to retrieve for each query
RETRIEVER_K=5
 
# =============================================================================
# LOGGING (Optional)
# =============================================================================
 
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =============================================================================
# STACK OVERFLOW SETTINGS (For SO integration)
# =============================================================================

# Stack Overflow database location (separate from Confluence)
STACKOVERFLOW_DB_PATH=./stackoverflow_db

# Tags to fetch from Stack Overflow (comma-separated)
# Example: python,json,api,rest-api,database,javascript
STACKOVERFLOW_TAGS=python,json,api,rest-api,database,javascript,testing,authentication

# Maximum number of questions to fetch per tag
STACKOVERFLOW_FETCH_LIMIT=1000

# Optional: Stack Exchange API key (for higher rate limits)
# Get your key at: https://stackapps.com/apps/oauth/register
SO_RATE_LIMIT_KEY=
 
# =============================================================================
# JIRA SETTINGS (For Jira ticket creator)
# =============================================================================

# Your Jira Cloud instance URL (e.g., https://your-domain.atlassian.net)
JIRA_URL=https://your-domain.atlassian.net

# Your Atlassian account email
JIRA_EMAIL=your@email.com

# Jira API Token (generate at https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=your_jira_api_token

# Your Jira project key (e.g., PROJ for PROJ-123)
JIRA_PROJECT_KEY=PROJ

# Team name to use as label on created tickets
JIRA_TEAM_NAME=your_team_name
 
